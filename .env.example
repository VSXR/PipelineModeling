# ── API ──────────────────────────────────────────────────────────────────────
MODEL_PATH=/app/model/weights/model.pkl
GIT_REPO_PATH=/app
DVC_REMOTE_PATH=/dvc-remote

# ── Seeder ────────────────────────────────────────────────────────────────────
REQUESTS_PER_SECOND=20
INFERENCE_CONCURRENCY=10
TRAINING_INTERVAL_S=30
TRAINING_BATCH_SIZE=50
DRIFT_ONSET_AFTER_S=120
DRIFT_MAGNITUDE=2.0

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_ADMIN_PASSWORD=admin

# ── MinIO (S3-compatible storage for DVC artifacts) ───────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
