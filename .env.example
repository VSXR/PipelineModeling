# == API ==============================================================
MODEL_PATH=./model/weights/model.pkl

# == MLflow Model Registry ============================================
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_NAME=pipeline-model

# == OpenTelemetry ====================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=pipeline-api

# == Seeder ===========================================================
REQUESTS_PER_SECOND=20
INFERENCE_CONCURRENCY=10
TRAINING_INTERVAL_S=30
TRAINING_BATCH_SIZE=50
DRIFT_ONSET_AFTER_S=120
DRIFT_MAGNITUDE=2.0

# == Grafana =========================================================
GF_ADMIN_PASSWORD=admin
API_URL=http://api:8000
GRAFANA_URL=http://grafana:3000
PROMETHEUS_URL=http://prometheus:9090

# == Debug (chaos engineering) =======================================
# Set to true only in local/dev environments; never in production.
ENABLE_DEBUG_ENDPOINTS=false
