# Copiar a .secrets y rellenar valores reales.
# .secrets está excluido de git — nunca lo versiones.
#
# MLFLOW_TRACKING_URI
#   El runner de act corre dentro de un contenedor efímero; "localhost" resuelve
#   a ese contenedor, no al host. host.docker.internal enruta al host desde dentro
#   de Docker Desktop (Windows/macOS). En Linux ver nota sobre --add-host más abajo.
MLFLOW_TRACKING_URI=http://host.docker.internal:5000

# MLFLOW_TRACKING_USERNAME / MLFLOW_TRACKING_PASSWORD
#   Credenciales configuradas en el stack MLflow local (variable MLFLOW_TRACKING_SERVER_AUTH
#   o proxy inverso). Necesarias para operaciones de escritura en Model Registry.
MLFLOW_TRACKING_USERNAME=admin
MLFLOW_TRACKING_PASSWORD=CHANGE_ME

# GITHUB_TOKEN
#   Personal Access Token clásico con scopes: write:packages, read:packages, repo.
#   Requerido por cd.yml para autenticar docker/login-action contra GHCR y por
#   ct.yml para crear tags y GitHub Releases vía gh CLI.
GITHUB_TOKEN=ghp_CHANGE_ME
